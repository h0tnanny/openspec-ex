{
  "name": "openspec-ex",
  "version": "1.2.0",
  "description": "Enhanced Spec-Driven Development (SDD) CLI with Native OpenSpec Skills Parity (explore, propose, apply-change, archive-change, sync-specs, edit), SSOT Explore, Subagent Research Delegation, Review Self-Audit, Presets Engine, Deterministic Backups, Multi-Agent Setup, and Interactive HTML Spec Viewer",
  "keywords": [
    "openspec",
    "specs",
    "ai",
    "cli",
    "spec-driven-development",
    "cursor",
    "antigravity",
    "claude-code",
    "windsurf",
    "copilot",
    "cline",
    "spec-viewer",
    "typescript"
  ],
  "homepage": "https://github.com/h0tnanny/openspec-ex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h0tnanny/openspec-ex.git"
  },
  "bugs": {
    "url": "https://github.com/h0tnanny/openspec-ex/issues"
  },
  "author": "OpenSpec-Ex Contributors (https://github.com/h0tnanny/openspec-ex)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "openspec-ex": "./dist/bin/cli.cjs",
    "opsx-ex": "./dist/bin/cli.cjs"
  },
  "files": [
    "dist",
    "templates",
    "rules",
    "skills",
    "workflows",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "spec:view": "node dist/bin/cli.cjs view",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
